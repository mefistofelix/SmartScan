<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed only so self-hosted LAN endpoints (http://192.168.x.x) work.
     The app warns the user whenever an endpoint is not https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
